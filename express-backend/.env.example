# Environment Configuration
NODE_ENV=production
# Options: development, staging, production

# Server Configuration
PORT=3000

# Supabase Configuration (REPLACE WITH YOUR ACTUAL VALUES)
# Get these from: Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# JWT Secret (for authentication)
JWT_SECRET=your_secure_jwt_secret_here_minimum_32_characters

# AI Backend URL (FastAPI service)
# For local: http://localhost:8000
# For production: Your deployed AI backend URL
AI_API_URL=http://your-ai-backend-url:8000

# CORS Configuration
# Comma-separated list of allowed origins for production
# Example: https://yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=*

# Database Configuration (if using MySQL instead of Supabase)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=news_app

# Optional: Logging
LOG_LEVEL=info
# Options: error, warn, info, debug
